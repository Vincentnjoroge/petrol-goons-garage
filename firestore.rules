rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Super Admin email whitelist (Petrol Goons platform team)
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email in [
        'michaeldiro@gmail.com',
        'mwololokimanthi@gmail.com',
        'thomasaquinas689@gmail.com',
        'viny.njoroge1@gmail.com'
      ];
    }

    // Check if user belongs to a garage
    function isGarageStaff(garageId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.garageId == garageId;
    }

    // Check if user is garage owner
    function isGarageOwner(garageId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.garageId == garageId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'garage_owner';
    }

    // ==============================
    // USERS COLLECTION (Global)
    // ==============================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow read, update: if isSuperAdmin();
      allow update: if request.auth != null;
    }

    // ==============================
    // GARAGES COLLECTION (Top-level)
    // ==============================
    match /garages/{garageId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if isGarageOwner(garageId);
      allow read, update: if isSuperAdmin();

      // STAFF
      match /staff/{staffId} {
        allow read, write: if isGarageOwner(garageId);
        allow read: if isGarageStaff(garageId);
        allow read: if isSuperAdmin();
        allow create: if request.auth != null;
      }

      // JOBS
      match /jobs/{jobId} {
        allow read: if isGarageStaff(garageId);
        allow create, update: if isGarageStaff(garageId);
        allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
        allow read: if isSuperAdmin();
      }

      // CUSTOMERS
      match /customers/{customerId} {
        allow read, write: if isGarageStaff(garageId);
        allow read: if request.auth != null && resource.data.userId == request.auth.uid;
        allow create: if request.auth != null;
        allow read: if isSuperAdmin();
      }

      // ACTIVITY LOG
      match /activity/{logId} {
        allow read, write: if isGarageStaff(garageId);
        allow create: if request.auth != null;
        allow read: if isSuperAdmin();
      }

      // SERVICES
      match /services/{serviceId} {
        allow read, write: if isGarageOwner(garageId);
        allow read: if isGarageStaff(garageId);
        allow read: if request.auth != null;
        allow read: if isSuperAdmin();
      }

      // REVIEWS
      match /reviews/{reviewId} {
        allow read: if isGarageStaff(garageId);
        allow read: if request.auth != null && resource.data.isPublic == true;
        allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
        allow update: if isGarageOwner(garageId);
        allow read: if isSuperAdmin();
      }
    }

    // LEGACY: Old bookings collection
    match /bookings/{bookingId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'cancelled';
      allow read, update: if isSuperAdmin();
    }

    // ==============================
    // COMMUNITY FEED (Global)
    // ==============================
    match /posts/{postId} {
      // Anyone can read posts (public feed)
      allow read: if true;
      // Only signed-in users can create posts
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500;
      // Author or super admin can update (likes, content)
      allow update: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isSuperAdmin()
      );
      // Author or super admin can delete
      allow delete: if request.auth != null && (
        resource.data.authorId == request.auth.uid ||
        isSuperAdmin()
      );

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 300;
        allow delete: if request.auth != null && (
          resource.data.authorId == request.auth.uid ||
          isSuperAdmin()
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
